        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Usuario {\n    +int id_usuario\n    +string nombre\n    +string apellido\n    +string correo\n    -string contrasena_hash\n    +string telefono\n    +datetime fecha_registro\n    +string rol\n    +registrar()\n    +iniciar_sesion()\n    +actualizar_datos()\n    +consultar_reportes()\n}\n\nclass Categoria {\n    +int id_categoria\n    +string nombre\n    +string descripcion\n    +registrar_categoria()\n    +actualizar_categoria()\n    +consultar_categoria()\n    +listar_categorias()\n}\n\nclass Ubicacion {\n    +int id_ubicacion\n    +string departamento\n    +string municipio\n    +string distrito\n    +string comunidad\n    +string direccion\n    +decimal latitud\n    +decimal longitud\n    +registrar_ubicacion()\n    +actualizar_ubicacion()\n    +consultar_ubicacion()\n    +obtener_coordenadas()\n}\n\nclass ReporteAgua {\n    +int id_reporte\n    +int id_usuario\n    +int id_categoria\n    +int id_ubicacion\n    +string titulo\n    +string descripcion\n    +datetime fecha_reporte\n    +string estado\n    +crear_reporte()\n    +actualizar_reporte()\n    +consultar_reporte()\n    +cambiar_estado()\n    +listar_reportes()\n    +filtrar_reportes()\n}\n\nclass Evidencia {\n    +int id_evidencia\n    +int id_reporte\n    +string nombre_archivo\n    +string ruta_archivo\n    +string descripcion\n    +datetime fecha_subida\n    +agregar_evidencia()\n    +consultar_evidencia()\n    +eliminar_evidencia()\n    +listar_evidencias()\n}\n\nclass Seguimiento {\n    +int id_seguimiento\n    +int id_reporte\n    +int id_usuario\n    +string descripcion\n    +datetime fecha_seguimiento\n    +string estado\n    +registrar_seguimiento()\n    +actualizar_seguimiento()\n    +consultar_seguimiento()\n    +listar_seguimientos()\n}\n\nUsuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ReporteAgua : registra\nUsuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Seguimiento : realiza\nCategoria \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ReporteAgua : clasifica\nUbicacion \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ReporteAgua : localiza\nReporteAgua \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Evidencia : contiene\nReporteAgua \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Seguimiento : recibe\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hDtkzBpx0nAfNqxJw4Fu-1">
